{
  "exclude": [
    "./tools",
    "./infrastructure",
    "./dist"
  ],
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "types": ["node", "jest"],
    "outDir": "./dist",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@tk-postral/common-utils": [
        "libs/common-utils/src"
      ],
      "@tk-postral/common-utils/*": [
        "libs/common-utils/src/*"
      ],
      "@tk-postral/payment-common": [
        "libs/payment-common/src"
      ],
      "@tk-postral/payment-common/*": [
        "libs/payment-common/src/*"
      ],
      "@tk-postral/postral-entities": [
        "libs/postral-entities/src"
      ],
      "@tk-postral/postral-entities/*": [
        "libs/postral-entities/src/*"
      ]
    }
  }
}